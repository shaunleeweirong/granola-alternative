{
  "name": "granola-alternative",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first meeting notes for macOS. Records both sides of a call, transcribes on-device, generates structured notes.",
  "license": "MIT",
  "main": "dist/src/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:main": "tsc -p tsconfig.main.json && node scripts/finalize-main-build.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:tap && npm run build:main && npm run build:renderer",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "test:core": "node --test --test-reporter=spec \"test/core/**/*.test.ts\"",
    "lint": "eslint src test",
    "dev": "vite",
    "start": "npm run build && npm run rebuild:electron && electron dist/src/main/index.js",
    "build:tap": "node scripts/build-audio-tap.mjs",
    "postinstall": "node scripts/build-audio-tap.mjs || echo '[audio-tap] not built yet - run: npm run build:tap'",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "doctor": "node scripts/doctor.mjs",
    "setup:mac": "bash scripts/setup-mac.sh",
    "preflight": "bash scripts/preflight.sh",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-rebuild -f -o better-sqlite3",
    "pretest": "node scripts/ensure-node-abi.mjs",
    "package:mac": "npm run build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
